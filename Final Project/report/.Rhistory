#| label: integration-figure
#| fig-cap: "Estimated difference in daily non-member trips between 2026 and 2025. Points show the estimated year effect; horizontal intervals show 95% confidence intervals."
#| fig-width: 8
#| fig-height: 5
# Order the models in the figure.
year_effects$model <- factor(
year_effects$model,
levels = c("Naive", "Weather-adjusted")
)
integration_plot <- ggplot(
year_effects,
aes(x = model, y = estimate)
) +
geom_hline(
yintercept = 0,
linetype = "dashed"
) +
geom_errorbar(
aes(ymin = conf.low, ymax = conf.high),
width = 0.15
) +
geom_point(size = 3) +
labs(
title = "The 2026 non-member trip difference remains positive",
subtitle = "Naive and weather-adjusted estimates with 95% confidence intervals",
x = NULL,
y = "Estimated difference in daily trips (2026 minus 2025)"
) +
theme_board
integration_plot
```r
#| label: integration-figure
#| fig-cap: "Observed daily non-member trips and fitted values from the naive and weather-adjusted models."
#| fig-width: 9
#| fig-height: 5
# Get fitted values from each model.
naive_predictions <- integration_daily |>
mutate(
fitted = predict(naive_model),
model = "Naive"
)
adjusted_predictions <- weather_model_data |>
mutate(
fitted = predict(adjusted_model),
model = "Weather-adjusted"
)
# Combine model predictions.
model_predictions <- bind_rows(
naive_predictions,
adjusted_predictions
)
# Plot observed trips and model fitted values.
integration_plot <- ggplot() +
geom_point(
data = integration_daily,
aes(x = date, y = non_member),
alpha = 0.25
) +
geom_line(
data = model_predictions,
aes(x = date, y = fitted, color = model),
linewidth = 1
) +
labs(
title = "Observed and modeled daily non-member trips",
subtitle = "Naive and weather-adjusted regression models",
x = "Date",
y = "Daily non-member trips",
color = "Model"
) +
theme_board
integration_plot
