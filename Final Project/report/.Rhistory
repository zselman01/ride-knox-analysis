#| label: setup
#| include: false
library(readr)
library(dplyr)
library(ggplot2)
library(lubridate)
library(broom)
# The handoff rule: this document reads ONLY what the SQL stage wrote to out/
# (plus the loader's reconciliation ledger). No raw file, no database
# connection, no hand-typed number anywhere in the prose.
monthly  <- read_csv("../out/monthly_by_product.csv")
daily    <- read_csv("../out/daily_products.csv")
weather  <- read_csv("../out/weather_daily.csv")
capacity <- read_csv("../out/capacity_by_year.csv")
coverage <- read_csv("../out/coverage.csv")
ledger   <- read_csv("../out/system_reconciliation.csv")
theme_board <- theme_minimal(base_size = 13) +
theme(plot.title = element_text(
size = 14,
face = "bold",
hjust = 0.5,
lineheight = 1.1,
margin = margin(b = 8)
),
plot.title.position = "plot",
plot.subtitle.position = "plot")
dir.create("figs", showWarnings = FALSE)
#| label: two-year-monthly-figure
#| fig-cap: "Monthly trips during the comparable January 1–October 11 periods in 2025 and 2026 for each rider type (casual, member, and day pass (for 2026))."
#| fig-width: 18
#| fig-height: 6
#| include: false
monthly_figure <- monthly |>
filter(!(month == "2025-11") & !(month == "2025-12"))
monthly_figure |>
filter(grepl("2026", month)) |>
summarise(total_trips = sum(trips, na.rm = TRUE))
ggplot(
monthly_figure,
aes(x = month, y = trips, color = product_code, group = product_code)
) +
geom_line(linewidth = 2) +
geom_point(size = 5) +
geom_vline(xintercept = 11, linetype = "dashed", colour = "black") +
annotate("text", x = 9, y = 19000, label = "New Year",
hjust = 0, size = 6, colour = "red") +
scale_x_discrete(guide = guide_axis(n.dodge = 2)) +
labs(
title = "2025 & 2026 Monthly Figure",
subtitle = "Both years, by product, coverage policy applied",
x = "Year-Month",
y = "Number of Trips",
color = "Rider Type",
caption = "n = 224,136 trips for 2025 and n = 233,803 trips for 2026, Ride Knox export."
) +
theme_board +
theme(
plot.subtitle = element_text(hjust = 0.5),
plot.title = element_text(size = rel(1.3)),
text = element_text(size = 20)
)
ggsave(
filename = "figs/two_year_monthly_by_prod.png",
plot = integration_plot,
width = 18,
height = 6,
dpi = 300
)
ggplot(
monthly_figure,
aes(x = month, y = trips, color = product_code, group = product_code)
) +
geom_line(linewidth = 2) +
geom_point(size = 5) +
geom_vline(xintercept = 11, linetype = "dashed", colour = "black") +
annotate("text", x = 9, y = 19000, label = "New Year",
hjust = 0, size = 6, colour = "red") +
scale_x_discrete(guide = guide_axis(n.dodge = 2)) +
labs(
title = "2025 & 2026 Monthly Figure",
subtitle = "Both years, by product, coverage policy applied",
x = "Year-Month",
y = "Number of Trips",
color = "Rider Type",
caption = "n = 224,136 trips for 2025 and n = 233,803 trips for 2026, Ride Knox export."
) +
theme_board +
theme(
plot.subtitle = element_text(hjust = 0.5),
plot.title = element_text(size = rel(1.3)),
